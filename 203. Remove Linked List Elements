/**
 * Definition for singly-linked list.
 * function ListNode(val, next) {
 *     this.val = (val===undefined ? 0 : val)
 *     this.next = (next===undefined ? null : next)
 * }
 */
/**
 * @param {ListNode} head
 * @param {number} val
 * @return {ListNode}
 */
var removeElements = function(head, val) {
       // Create a dummy node to simplify edge cases like removing the head node
    const dummy = { val: 0, next: head };
    let prev = dummy; // Pointer to track the previous node
    let current = head; // Pointer to traverse the list

    while (current !== null) {
        if (current.val === val) {
            // Skip the current node if its value matches the target
            prev.next = current.next;
        } else {
            // Move the `prev` pointer forward only if we don't remove the current node
            prev = current;
        }
        // Move the `current` pointer to the next node
        current = current.next;
    }

    // Return the new head (skip the dummy node)
    return dummy.next;
};
